# Copy this file to `.env` and adjust it:  cp .env.example .env
#
# Every value below is a working local-development default, except the secrets
# marked CHANGE ME — replace those before exposing the app to anyone else.

# --- Embedding model -------------------------------------------------------
# Served by the `embedding` container (HuggingFace text-embeddings-inference).
# EMBEDDING_MODEL_ID must always be set together with a matching revision.
EMBEDDING_MODEL_ID=BAAI/bge-m3
# Output dimension of the model above; the Qdrant collection is created with it.
EMBEDDING_MODEL_DIM=1024
# Upper bound on tokens per batch. This drives the embedding container's peak
# memory during warm-up: 4096 needs roughly 8 GB of RAM for bge-m3 on CPU and is
# killed on a default Docker Desktop VM. Inputs longer than this are truncated.
EMBEDDING_MAX_BATCH_TOKENS=2048
# Only required for gated or private models on the HuggingFace Hub.
# HF_TOKEN=

# How the logic service talks to that container.
EMBEDDING_MODEL_BASE_URL=http://embedding:80/v1
EMBEDDING_MODEL_API_KEY=unused

# --- Vector store ----------------------------------------------------------
VECTORSTORE_SERVICE_HOST=qdrant
VECTORSTORE_SERVICE_PORT=6334
# Must match the embedding model the vectors were built with.
VECTORSTORE_COLLECTION_NAME=report_embeddings_medidex

# --- Postgres --------------------------------------------------------------
# The databases themselves are NOT created by this repo; see
# backend/postgres-init/README.md.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres            # CHANGE ME
POSTGRES_DB_RESOURCES=resources      # studies/reports, used by logic
POSTGRES_DB_KEYCLOAK=keycloak         # used by the keycloak container
# Host directory mounted at /backups inside the postgres container.
POSTGRES_BACKUPS=./data/runtime/postgres-backups

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Services --------------------------------------------------------------
DOCLING_URL=http://docling:5001
BACKEND_API_URL=http://logic:8002/backend
# Used by the scripts in backend/tools to call the logic service.
BACKEND_API_KEY=                      # CHANGE ME

# --- Auth --------------------------------------------------------------
# Identity provider for both the frontend and the backend. Realm, roles,
# groups and the two clients below are provisioned automatically from
# keycloak/realm-medidex.json on first boot.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_before_deploying   # CHANGE ME
KEYCLOAK_REALM=medidex

# "medidex-frontend" client: a public client (no secret) used directly by the
# browser (via keycloak-js) for login, registration, token refresh and
# logout. The frontend server only ever sees the tokens Keycloak already
# issued to the browser - it never talks OIDC to Keycloak itself.
KEYCLOAK_CLIENT_ID=medidex-frontend

# Browser-reachable Keycloak URL. Used by the backend's own Swagger UI
# (/docs) "Authorize" button, which redirects the browser straight to
# Keycloak's login page (authorization-code + PKCE) - the browser can't
# resolve the internal "keycloak" hostname the logic service itself uses.
# Defaults to KEYCLOAK_URL if unset; override for non-local deployments.
KEYCLOAK_PUBLIC_URL=http://localhost:8081

# "medidex-backoffice" client: confidential service-account client used
# server-side by the frontend to call Keycloak's Admin REST API
# (list/approve/delete users, manage roles) and by app-init's admin bootstrap.
KEYCLOAK_ADMIN_CLIENT_ID=medidex-backoffice
KEYCLOAK_ADMIN_CLIENT_SECRET=dev_only_backoffice_client_secret_change_me   # CHANGE ME

# Optional bootstrap account. Set both values to have app-init create an
# approved admin in Keycloak on startup (idempotent; safe to leave set).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_before_deploying
ADMIN_NAME=Administrator

# --- LLM -------------------------------------------------------------------
# Required for the agent/extraction features; the rest of the app runs without it.
OPENAI_API_KEY=

# --- Misc ------------------------------------------------------------------
STAGE=local
DEBUG=false
