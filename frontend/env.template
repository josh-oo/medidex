# Copy this file to `.env.local` and adjust it for local `npm run dev` use.
# These are baked into the built bundle at build time (see Dockerfile), so
# also pass them as build args when building the Docker image.

# Keycloak (browser-facing; must be reachable from the user's browser)
VITE_KEYCLOAK_URL="http://localhost:8081"
VITE_KEYCLOAK_REALM="medidex"
VITE_KEYCLOAK_CLIENT_ID="medidex-frontend"

# Backend API (browser-facing)
VITE_BACKEND_API_URL="http://localhost:8002/backend"
